SECRET_KEY=django-insecure-predictlosweb-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# MongoDB (Patient Data - Giữ từ v1)
MONGODB_URI=mongodb+srv://lehungnlb_db_user:m7MmeoDQXTii4jyX@cluster1.otlijpf.mongodb.net/?appName=Cluster1
MONGODB_NAME=predictlos_db

# Celery / Redis (dùng chung Redis với Feast Online Store sau này)
CELERY_BROKER_URL=redis://:redis_password@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:redis_password@localhost:6379/0
REDIS_PASSWORD=redis_password
REDIS_URL=redis://:redis_password@localhost:6379/0

# ML Retrain Config
RETRAIN_SAMPLE_THRESHOLD=10
RETRAIN_DAYS_THRESHOLD=7

# PostgreSQL (MLflow metadata backend)
POSTGRES_USER=hung_admin
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=mlflow_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MinIO (Object storage cho MLflow artifacts + DVC remote)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET_MLFLOW=mlflow-artifacts
MINIO_BUCKET_DVC=dvc-storage

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
MLFLOW_EXPERIMENT_NAME=los_prediction
MLFLOW_REGISTERED_MODEL_NAME=los_model
AWS_ACCESS_KEY_ID=minio_admin
AWS_SECRET_ACCESS_KEY=minio_password

# Evidently Drift Monitoring (v2 — Giai đoạn 2)
EVIDENTLY_DRIFT_THRESHOLD_HIGH=0.5
EVIDENTLY_DRIFT_THRESHOLD_MEDIUM=0.25

# DVC Data Versioning (v2 — Giai đoạn 3)
DVC_REMOTE_NAME=minio_remote
DVC_REMOTE_URL=s3://dvc-storage/snapshots
DVC_SNAPSHOTS_DIR=data/dvc_snapshots

# Feast Feature Store (v2 — Giai đoạn 4)
# Redis DB 1 (DB 0 dùng cho Celery, DB 1 dành riêng cho Feast Online Store)
FEAST_REDIS_URL=redis://:redis_password@localhost:6379/1
FEAST_STORE_DIR=feature_store
FEAST_REGISTRY_PATH=data/feast_registry/registry.db

# FastAPI Inference Service (v2 — Giai đoạn 5)
FASTAPI_URL=http://localhost:8001
NGINX_URL=http://localhost
GITHUB_REPO_URL=https://github.com/senKo183/FinalCNM

# GitHub Actions (Giai đoạn 5)
