REDIS_URL=redis://:redis_password@localhost:6379/0

# ML Retrain Config
RETRAIN_SAMPLE_THRESHOLD=10
RETRAIN_DAYS_THRESHOLD=7

# PostgreSQL (MLflow metadata backend)
POSTGRES_USER=hung_admin
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=mlflow_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MinIO (Object storage cho MLflow artifacts + DVC remote)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_password
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET_MLFLOW=mlflow-artifacts
MINIO_BUCKET_DVC=dvc-storage

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
MLFLOW_EXPERIMENT_NAME=los_prediction
MLFLOW_REGISTERED_MODEL_NAME=los_model
AWS_ACCESS_KEY_ID=minio_admin
AWS_SECRET_ACCESS_KEY=minio_password

# Evidently Drift Monitoring (v2 — Giai đoạn 2)
EVIDENTLY_DRIFT_THRESHOLD_HIGH=0.5
EVIDENTLY_DRIFT_THRESHOLD_MEDIUM=0.25

# GitHub Actions (sẽ dùng ở Giai đoạn 5)
GH_ACTION_TOKEN=your_github_token_here
